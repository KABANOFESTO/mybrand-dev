
APP_PORT=3035
APP_NAME=mybrand
APP_VERSION=1.0.0
API_PREFIX=api
NODE_ENV=development

# Database
# Preferred Prisma format. Keep this in sync with DB_* values below if you use both.
DATABASE_URL=postgresql://postgres:password@localhost:5432/mybranddb?schema=public
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=
DB_NAME=mybranddb
DB_SYNCHRONIZE=false
PRISMA_LOG_QUERIES=false

# JWT
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRATION=1d
JWT_REFRESH_EXPIRATION=7d

# Auth cookies
AUTH_ACCESS_COOKIE_NAME=access_token
AUTH_REFRESH_COOKIE_NAME=refresh_token
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_PATH=/

# Bootstrap admin
BOOTSTRAP_ADMIN_ENABLED=true
BOOTSTRAP_ADMIN_NAME=Portfolio Owner
BOOTSTRAP_ADMIN_EMAIL=owner@mybrand.com
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe123!
BOOTSTRAP_ADMIN_ROLE=OWNER

# CORS pour le frontend
CORS_ORIGIN=http://localhost:5173

# Swagger
SWAGGER_TITLE="MyBrand API"
SWAGGER_DESCRIPTION="API Documentation"
SWAGGER_VERSION="1.0"
SWAGGER_ENABLED=true

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=

# GitHub OAuth
GITHUB_CLIENT_ID= 
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=

#email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

#cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Gemini Api Key
GEMINI_API_KEY=
